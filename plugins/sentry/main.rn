// Les erreurs que Sentry remonte, et de quoi les confier à un agent.
//
// Claudhub **lit** Sentry ; il ne lui envoie jamais rien. Un rapport d'erreur
// est un meilleur point de départ qu'une intention — il porte déjà la trace et
// le fichier fautif —, et le geste utile est de le remettre à l'agent avec le
// code d'autour.
//
// Ce que la vue montre est calqué sur la page de Sentry, et pas par révérence :
// une erreur ne se lit pas dans une trace seule. Ce qui la rend diagnosticable
// est ce qu'il y a **autour** — depuis quand elle dure, combien de fois, sur
// quelle release, dans quel environnement, ce que l'utilisateur faisait juste
// avant. Une trace sans ce contexte se lit deux fois : ici, puis dans le
// navigateur.

use claudhub::*;

const ISSUES_PER_PAGE = 50;

/// Combien de fils d'Ariane on garde. Les derniers : ce sont eux qui décrivent
/// la seconde qui précède, et une liste de cent noie ce qu'on cherche.
const CRUMBS = 12;

pub async fn init(worktree) {
    let project = state("project");
    if project == "" {
        return Ok(fresh([], "no-project", "", ""));
    }
    let path = `/projects/${setting("org")}/${project}/issues/?query=${escape(setting("query"))}&statsPeriod=14d&limit=${ISSUES_PER_PAGE}`;
    // **L'échec est rattrapé et non propagé.** Un `?` ici rendrait `init`
    // fautif, donc l'état absent, donc `view` jamais appelée — et le sélecteur
    // s'en irait avec elle. Un projet mal tapé donne un 404, et il faut
    // précisément pouvoir le corriger depuis l'écran qui le dit.
    let body = match api(path).await {
        Ok(body) => body,
        Err(why) => return Ok(fresh([], "failed", project, why)),
    };
    let issues = [];
    // Un compteur à nous, et non `issues.len()` : la longueur d'un `Vec` est
    // **non signée** ici, et un rang non signé comparé au `-1` de « rien de
    // choisi » fait échouer la comparaison au lieu de la rendre fausse.
    let rank = 0;
    for raw in json(body)? {
        // Le rang est posé ici, une fois : c'est ce que le filtre ne change
        // pas, et donc la seule chose par quoi une sélection peut survivre à
        // une frappe dans le champ.
        issues.push(issue_of(raw, rank));
        rank += 1;
    }
    Ok(fresh(
        issues,
        if issues.is_empty() { "empty" } else { "" },
        project,
        "",
    ))
}

fn fresh(issues, note, typed, why) {
    #{
        issues: issues,
        chosen: -1,
        event: (),
        event_why: "",
        // Les valeurs les plus vues de chaque tag : release, environnement,
        // navigateur, locataire. C'est le seul renseignement de cette page qui
        // ne parle pas d'un événement mais de **tous**, et c'est celui qui dit
        // si le bug est partout ou chez un seul.
        tags: [],
        note: note,
        typed: typed,
        why: why,
        filter: "",
    }
}

/// Les deux panneaux, sur un seul état.
///
/// `view` est appelée une fois par panneau déclaré, avec son identifiant. Elle
/// reste pure et synchrone : c'est ce qui permet de la rappeler chaque fois que
/// l'état bouge, et donc de peindre les deux d'un même geste — sans quoi le
/// détail montrerait encore ce que l'état disait avant le clic.
pub fn view(s, panel) {
    if panel == "issue" {
        detail(s)
    } else {
        issues(s)
    }
}

// — La liste, à gauche ——————————————————————————————————————————————————

/// De quoi choisir, et rien d'autre.
fn issues(s) {
    // **Le sélecteur est toujours là**, et pas seulement quand rien ne marche.
    // C'est le seul réglage de ce plugin qui appartient au dépôt, on le corrige
    // aussi souvent qu'on le pose, et une commande qu'il faut faire échouer
    // pour retrouver n'est pas une commande.
    if s.note == "no-project" {
        return column([picker(s), empty("Quel projet Sentry, pour ce dépôt ?")]);
    }
    if s.note == "failed" {
        return column([
            picker(s),
            empty("Sentry n'a pas répondu pour ce projet."),
            code(s.why, ""),
        ]);
    }
    if s.note == "empty" {
        return column([picker(s), empty("Aucune erreur non résolue.")]);
    }

    // **Le filtre porte sur la liste qu'on a**, il ne repart pas interroger
    // Sentry : la requête, elle, est un réglage, et une frappe ne doit pas
    // coûter un aller-retour. Ce qu'il cherche est le titre et le coupable —
    // c'est ce qui est à l'écran.
    let needle = s.filter.trim().to_lowercase();
    let rows = [];
    let kept = 0;
    let selected = -1;
    for issue in s.issues {
        if needle != "" && !matches(issue, needle) {
            continue;
        }
        if issue.rank == s.chosen {
            selected = kept;
        }
        rows.push(item(
            issue.title,
            `${issue.culprit}${separator(issue.culprit, issue.last)}${issue.last}`,
            issue.count,
            glyph(issue.level),
        ));
        kept += 1;
    }
    if rows.is_empty() {
        return column([
            picker(s),
            field("filter", s.filter, "filtrer", "filter"),
            empty("Aucune erreur ne correspond."),
        ]);
    }
    column([
        picker(s),
        field("filter", s.filter, "filtrer", "filter"),
        dim(count_line(kept, s.issues.len())),
        // La liste **est** ce panneau : elle prend ce qui reste, défile
        // elle-même et porte sa barre. Sans `fill`, elle se voyait donner une
        // hauteur d'avance et le panneau finissait sur une bande de rien.
        fill(list("issues", rows, selected, "choose")),
    ])
}

fn matches(issue, needle) {
    issue.title.to_lowercase().contains(needle)
        || issue.culprit.to_lowercase().contains(needle)
}

fn count_line(kept, total) {
    if kept == total {
        `${total} erreurs`
    } else {
        `${kept} sur ${total} erreurs`
    }
}

fn separator(left, right) {
    if left != "" && right != "" { " · " } else { "" }
}

/// Le nom du projet, qui appartient au dépôt et non au compte.
///
/// Ici et pas dans les réglages : la page des réglages ne connaît que les clés
/// globales d'un plugin, et un projet Sentry change d'un dépôt à l'autre.
fn picker(s) {
    row([
        dim(setting("org")),
        field("project", s.typed, "nom du projet Sentry", "typing"),
        primary(button("Enregistrer", "check", "set-project", "")),
    ])
}

// — L'erreur ouverte, au centre —————————————————————————————————————————

/// Sa trace, le code déployé, ce qu'on sait d'elle, et le geste.
///
/// C'est la moitié qui a besoin de largeur — un extrait de code et une pile de
/// chemins — et c'est ce qu'un seul panneau ne pouvait pas donner.
fn detail(s) {
    let issue = chosen_issue(s);
    if issue is Tuple {
        return empty("Choisissez une erreur dans la liste.");
    }

    let body = [];

    // L'en-tête : le type de l'exception, puis son message derrière un filet
    // de la couleur du niveau. Deux lignes et non une, parce que ce sont deux
    // choses — la classe qui a été levée, et ce qu'elle disait.
    body.push(title(issue.kind));
    if issue.value != "" {
        body.push(callout(issue.value, tone_of(issue.level)));
    }
    if issue.culprit != "" {
        body.push(dim(issue.culprit));
    }

    body.push(row(marks(issue)));
    body.push(fields(counters(issue)));
    body.push(row([
        primary(button("Confier à l'agent", "bot", "hand", "")),
        link("Ouvrir dans Sentry", issue.permalink, "external-link"),
    ]));
    body.push(divider());

    if s.event_why != "" {
        // Sous l'issue et non à la place du panneau : la liste des autres n'a
        // rien fait de mal, et ce qu'on vient de lire d'elle non plus.
        body.push(callout(s.event_why, "warning"));
        return column(body);
    }
    if s.event is Tuple {
        body.push(spinner());
        return column(body);
    }

    for node in highlights(s.event) {
        body.push(node);
    }
    for node in distribution(s) {
        body.push(node);
    }
    for node in stack(s.event) {
        body.push(node);
    }
    for node in crumbs(s.event) {
        body.push(node);
    }
    column(body)
}

fn chosen_issue(s) {
    if s.chosen < 0 || s.chosen >= s.issues.len() {
        return ();
    }
    s.issues[s.chosen]
}

/// Les pastilles de l'en-tête : ce qu'on lit avant de lire quoi que ce soit.
fn marks(issue) {
    let out = [badge(issue.level, tone_of(issue.level))];
    if issue.status != "" {
        out.push(badge(issue.status, status_tone(issue.status)));
    }
    if issue.short_id != "" {
        // **Un bouton et non un texte** : c'est la référence qu'on emporte
        // ailleurs — un nom de branche, un message de commit, un message à
        // quelqu'un —, et un panneau n'a pas de sélection de texte où aller la
        // prendre à la main.
        out.push(button(issue.short_id, "copy", "copy-id", issue.short_id));
    }
    out
}

/// Les quatre nombres de l'en-tête de Sentry, alignés.
fn counters(issue) {
    let out = [pair("événements", issue.count)];
    if issue.users != "" && issue.users != "0" {
        out.push(pair("utilisateurs", issue.users));
    }
    if issue.first != "" {
        out.push(pair("vue pour la première fois", issue.first));
    }
    if issue.last != "" {
        out.push(pair("vue pour la dernière fois", issue.last));
    }
    out
}

/// Les tags de l'événement, en table : ce sont eux qui disent *dans quelles
/// conditions*. Sentry appelle ça « Highlights », et c'est le bloc qu'on lit
/// juste après le titre.
fn highlights(event) {
    if event.tags.is_empty() {
        return [];
    }
    let rows = [];
    for tag in event.tags {
        let one = pair(tag.key, tag.value);
        if tag.key == "level" || tag.key == "handled" {
            one = toned(one, level_tone(tag.key, tag.value));
        }
        rows.push(one);
    }
    [section("Contexte", [fields(rows)])]
}

/// Ce que les tags donnent **sur toutes les occurrences**, en barres.
fn distribution(s) {
    if s.tags.is_empty() {
        return [];
    }
    let out = [];
    for tag in s.tags {
        let bars = [];
        for value in tag.values {
            bars.push(meter(value.name, `${value.percent} %`, value.percent));
        }
        out.push(section(tag.name, bars));
    }
    // Repliée d'emblée : ce sont des proportions qu'on regarde une fois, quand
    // on se demande si le bug est partout ou chez un seul — et sept tags
    // dépliés poussent la trace hors de l'écran, qui est ce qu'on est venu
    // lire.
    [folded(section("Répartition", out))]
}

/// La trace, la plus récente en premier.
///
/// L'ordre de Sentry est celui de l'appel — le plus ancien d'abord —, et ce
/// qu'on vient chercher est la ligne qui a levé. On la remonte donc en tête,
/// comme la page le fait de son côté.
fn stack(event) {
    if event.frames.is_empty() {
        return [];
    }
    // Renversée en la reconstruisant plutôt qu'en comptant à rebours : la
    // longueur d'un `Vec` est non signée, et `len() - 1` sur une pile vide
    // déborde par en dessous au lieu de rendre -1.
    let ordered = [];
    for frame in event.frames {
        ordered.insert(0, frame);
    }
    let out = [];
    for frame in ordered {
        out.push(frame_head(frame));
        if frame.text != "" {
            out.push(snippet(frame.text, frame.language, frame.first, frame.line));
        }
    }
    [section(`Trace (${event.frames.len()})`, out)]
}

/// La ligne d'un cadre : le chemin qu'on clique, la fonction, et ce qui le
/// distingue.
fn frame_head(frame) {
    let out = [button(
        `${frame.path}:${frame.line}`,
        if frame.in_app { "file-code" } else { "file" },
        "open",
        `${frame.path}:${frame.line}`,
    )];
    if frame.function != "" {
        out.push(mono(frame.function));
    }
    if frame.in_app {
        out.push(badge("app", "info"));
    }
    row(out)
}

/// Le fil d'Ariane : ce qui s'est passé juste avant.
///
/// C'est le renseignement que la trace ne porte pas — une requête, une
/// requête SQL, un log —, et souvent celui qui explique *pourquoi* on est
/// arrivé là avec ces valeurs-là.
fn crumbs(event) {
    if event.crumbs.is_empty() {
        return [];
    }
    let rows = [];
    for crumb in event.crumbs {
        rows.push(item(crumb.message, crumb.category, crumb.level, crumb.icon));
    }
    [section(`Fil d'Ariane (${rows.len()})`, [list("crumbs", rows, -1, "")])]
}

// — Les gestes ——————————————————————————————————————————————————————————

pub async fn update(s, action, payload) {
    if action == "typing" {
        // On retient ce qui est tapé sans rien aller chercher : une requête par
        // frappe interrogerait Sentry à chaque lettre du nom du projet.
        s.typed = payload;
        return Ok(s);
    }

    if action == "filter" {
        s.filter = payload;
        return Ok(s);
    }

    if action == "set-project" {
        let name = s.typed.trim();
        if name == "" {
            return Ok(s);
        }
        // Par dépôt : deux dépôts d'une même organisation n'ont pas les mêmes
        // erreurs. `set_state` écrit contre le dépôt regardé.
        set_state("project", name);
        // `state` relit ce qu'on vient d'écrire : c'est ce qui permet de
        // relancer `init` dans la foulée plutôt que d'attendre un tour.
        return init(worktree()).await;
    }

    if action == "choose" {
        // **L'indice vient de la liste affichée, la sélection de la liste
        // entière.** Un filtre change les rangs, donc ce qu'on retient est le
        // rang que l'issue porte depuis `init` — sans quoi effacer le filtre
        // ouvrirait une autre erreur que celle qu'on lisait.
        let shown = payload.parse::<i64>()?;
        let picked = pick(s, shown);
        if picked < 0 {
            return Ok(s);
        }
        s.chosen = picked;
        s.event = ();
        s.event_why = "";
        s.tags = [];
        let id = s.issues[s.chosen].id;
        // Le dernier événement d'une issue : c'est lui qui porte la trace et le
        // code **déployé** au moment de l'erreur — le relire sur le disque
        // aujourd'hui donnerait autre chose.
        //
        // `/organizations/{org}/issues/{id}/events/` et non `…/events/latest/`,
        // qui a disparu de l'API et répond 404. `full=true` est ce qui ramène
        // la pile : sans lui, la réponse n'a que les métadonnées.
        let path = `/organizations/${setting("org")}/issues/${id}/events/?full=true&per_page=1`;
        // Rattrapé et non propagé : une issue dont l'événement a expiré ne doit
        // pas emporter la liste des autres.
        match api(path).await {
            Ok(body) => {
                let events = json(body)?;
                if events.is_empty() {
                    s.event_why = "Sentry ne garde plus d'événement pour cette erreur.";
                } else {
                    s.event = event_of(events[0]);
                }
            }
            Err(why) => s.event_why = why,
        }
        // La répartition est un second aller-retour, et son échec ne dit rien
        // de plus que « pas de barres » : la trace, elle, est arrivée.
        match api(`/organizations/${setting("org")}/issues/${id}/tags/`).await {
            Ok(body) => s.tags = tags_of(json(body)?),
            Err(why) => log(`tags: ${why}`),
        }
        return Ok(s);
    }

    if action == "open" {
        let parts = payload.split(':').collect::<Vec>();
        open(parts[0], parts[1].parse::<i64>()?);
        return Ok(s);
    }

    if action == "copy-id" {
        copy(payload);
        notify(`${payload} copié`);
        return Ok(s);
    }

    if action == "hand" {
        // **Pas de `notify` ici.** Le prompt s'ouvre en relecture avant de
        // partir, et le script ne sait pas ce qu'on en fera : annoncer que
        // l'erreur est confiée alors que le dialogue attend encore, c'est
        // dire une chose fausse une fois sur deux. Ce qui répond, ce sont le
        // dialogue puis l'onglet du terminal où le collage arrive.
        agent(prompt(s));
        return Ok(s);
    }

    Ok(s)
}

/// Le rang, dans la liste entière, de la n-ième ligne affichée.
fn pick(s, shown) {
    let needle = s.filter.trim().to_lowercase();
    let seen = 0;
    for issue in s.issues {
        if needle != "" && !matches(issue, needle) {
            continue;
        }
        if seen == shown {
            return issue.rank;
        }
        seen += 1;
    }
    -1
}

/// Ce qui part à l'agent : la pile entière — c'est le chemin qui a mené là —
/// mais le code des seules frames de l'application, une pile de framework
/// faisant cent lignes où le bug n'est pas.
fn prompt(s) {
    let issue = s.issues[s.chosen];
    let out = [setting("intro"), ""];
    for line in reference(issue) {
        out.push(line);
    }
    // Le bouton est peint au-dessus de la trace, donc pressable avant qu'elle
    // n'arrive : ce qui part alors est ce qu'on sait, et non une erreur.
    if s.event is Tuple {
        out.push(issue.kind);
        out.push(issue.value);
        out.push(issue.culprit);
        return join(out, "\n");
    }
    out.push(`# ${issue.kind}`);
    if issue.value != "" {
        out.push(issue.value);
    }
    if issue.culprit != "" {
        out.push(issue.culprit);
    }
    out.push(`${issue.count} occurrences, ${issue.first} → ${issue.last}`);
    out.push("");
    if !s.event.tags.is_empty() {
        out.push("## Contexte");
        for tag in s.event.tags {
            out.push(`- ${tag.key}: ${tag.value}`);
        }
        out.push("");
    }
    out.push("## Trace");
    for frame in s.event.frames {
        let line = `- ${frame.path}:${frame.line}`;
        if frame.function != "" {
            line += ` · ${frame.function}`;
        }
        out.push(line);
    }
    for frame in s.event.frames {
        if !frame.in_app || frame.text == "" {
            continue;
        }
        out.push("");
        out.push(`## ${frame.path}:${frame.line}`);
        out.push("```");
        out.push(numbered(frame));
        out.push("```");
    }
    if !s.event.crumbs.is_empty() {
        out.push("");
        out.push("## Fil d'Ariane");
        for crumb in s.event.crumbs {
            out.push(`- ${crumb.category} · ${crumb.message}`);
        }
    }
    join(out, "\n")
}

/// De quoi retrouver le ticket, en tête de ce qui part à l'agent.
///
/// **Ce qu'on recopie est une photographie, et l'agent peut avoir la source.**
/// Le texte porte l'événement d'un instant ; les questions qui viennent ensuite
/// — est-ce que ça arrive encore, depuis quelle release, sur combien
/// d'utilisateurs — se posent à Sentry. Un agent qui a le serveur MCP les pose
/// lui-même, et tout ce qu'il lui manquait était l'identifiant. Celui qui ne
/// l'a pas a le permalien, qui se lit à la main.
///
/// L'identifiant court d'abord : c'est celui qu'une équipe s'échange et celui
/// que les outils prennent. Le numérique reste, l'API le demandant sur
/// certaines routes.
fn reference(issue) {
    let out = [];
    if issue.short_id != "" {
        out.push(`- Ticket Sentry : ${issue.short_id}`);
    }
    if issue.id != "" {
        out.push(`- Identifiant : ${issue.id}`);
    }
    let org = setting("org");
    if org != "" {
        out.push(`- Organisation : ${org}`);
    }
    if issue.permalink != "" {
        out.push(`- ${issue.permalink}`);
    }
    if out.is_empty() {
        return out;
    }
    out.push("");
    out.push("Si tu as accès au serveur MCP de Sentry, tu peux lui demander le reste avec cette référence.");
    out.push("");
    out
}

/// L'extrait tel qu'il part au prompt : numéroté, la ligne fautive marquée.
///
/// La marque n'est pas une décoration ici : le texte arrive à l'agent sans la
/// gouttière que le panneau peint, et « la ligne 46 » dans un bloc de onze
/// lignes se compte à la main sans elle.
fn numbered(frame) {
    let out = [];
    let number = frame.first;
    for line in frame.text.split('\n') {
        let mark = if number == frame.line { ">" } else { " " };
        out.push(`${mark} ${number}  ${line}`);
        number += 1;
    }
    join(out, "\n")
}

// — Ce que l'API rend ——————————————————————————————————————————————————

async fn api(path) {
    let url = `${setting("host")}/api/0${path}`;
    // Le jeton n'est pas lu ici : `{secret}` est remplacé par le worker.
    http("GET", url, [("Authorization", "Bearer {secret}")], "", "token").await
}

fn issue_of(raw, rank) {
    let meta = at(raw, "metadata", #{});
    let title = str_of(raw, "title");
    #{
        // Le rang est écrit ici et pas déduit d'une boucle : il survit au
        // filtre, qui est ce qui rend la liste affichée différente de la liste
        // entière.
        rank: rank,
        id: str_of(raw, "id"),
        title: title,
        // Sentry coupe son titre en deux : le type de l'exception, et ce
        // qu'elle disait. Le titre entier reste pour la liste, où il n'y a
        // qu'une ligne.
        kind: or_else(str_of(meta, "type"), title),
        value: str_of(meta, "value"),
        culprit: str_of(raw, "culprit"),
        level: str_of(raw, "level"),
        status: str_of(raw, "substatus"),
        short_id: str_of(raw, "shortId"),
        // Sentry écrit le compte en **chaîne** dans la liste des issues et en
        // nombre ailleurs. Les deux se lisent.
        count: str_of(raw, "count"),
        users: str_of(raw, "userCount"),
        first: ago(str_of(raw, "firstSeen")),
        last: ago(str_of(raw, "lastSeen")),
        permalink: str_of(raw, "permalink"),
    }
}

fn event_of(raw) {
    let frames = [];
    let crumbs = [];
    for entry in at(raw, "entries", []) {
        let kind = str_of(entry, "type");
        let data = at(entry, "data", #{});
        if kind == "exception" || kind == "stacktrace" {
            // Deux formes selon le SDK : `exception.values[].stacktrace.frames`
            // et `stacktrace.frames`. Les deux existent, et un client qui n'en
            // lit qu'une affiche une trace vide sur la moitié des projets.
            for values in at(data, "values", []) {
                collect(at(values, "stacktrace", #{}), frames);
            }
            collect(data, frames);
        }
        if kind == "breadcrumbs" {
            collect_crumbs(data, crumbs);
        }
    }
    let tags = [];
    for tag in at(raw, "tags", []) {
        let key = str_of(tag, "key");
        if key == "" {
            continue;
        }
        tags.push(#{ key: key, value: str_of(tag, "value") });
    }
    #{
        message: str_of(raw, "message"),
        frames: frames,
        crumbs: crumbs,
        tags: tags,
    }
}

fn collect(stack, frames) {
    for raw in at(stack, "frames", []) {
        let line = at(raw, "lineNo", 0);
        let name = str_of(raw, "filename");
        if name == "" {
            name = str_of(raw, "absPath");
        }
        if name == "" {
            name = str_of(raw, "module");
        }
        let excerpt = context_of(raw);
        frames.push(#{
            path: name,
            line: line,
            function: str_of(raw, "function"),
            in_app: at(raw, "inApp", false),
            text: excerpt.text,
            first: excerpt.first,
            language: language_of(name),
        });
    }
}

/// Le code d'autour, tel que Sentry le rend : `[[numéro, texte], …]`.
///
/// Le texte part **nu**, sans numéros : c'est le panneau qui les peint dans une
/// colonne à eux, ce qui laisse l'extrait copiable tel quel — et c'est ce qu'on
/// fait d'un extrait, le coller dans un fichier.
fn context_of(raw) {
    let lines = [];
    let first = 0;
    let started = false;
    for pair in at(raw, "context", []) {
        if !started {
            first = pair[0];
            started = true;
        }
        lines.push(`${pair[1]}`);
    }
    #{ text: join(lines, "\n"), first: first }
}

/// Les valeurs les plus vues de chaque tag, en pourcentage.
fn tags_of(raw) {
    let out = [];
    for tag in raw {
        let values = [];
        let total = at(tag, "totalValues", 0);
        for value in at(tag, "topValues", []) {
            let count = at(value, "count", 0);
            values.push(#{
                name: or_else(str_of(value, "name"), str_of(value, "value")),
                percent: if total > 0 { count * 100 / total } else { 0 },
            });
        }
        if values.is_empty() {
            continue;
        }
        out.push(#{
            name: or_else(str_of(tag, "name"), str_of(tag, "key")),
            values: values,
        });
    }
    out
}

fn collect_crumbs(data, crumbs) {
    let all = at(data, "values", []);
    // Les derniers, et dans l'ordre où ils se sont produits : ce sont eux qui
    // décrivent la seconde qui précède.
    let dropped = if all.len() > CRUMBS { all.len() - CRUMBS } else { 0 };
    let seen = 0;
    for raw in all {
        if seen < dropped {
            seen += 1;
            continue;
        }
        let level = str_of(raw, "level");
        crumbs.push(#{
            message: or_else(str_of(raw, "message"), str_of(raw, "type")),
            category: str_of(raw, "category"),
            level: level,
            icon: glyph(level),
        });
    }
}

// — Lire du JSON sans se faire piéger par un champ absent ————————————————

/// Un champ d'objet JSON, ou le repli quand il n'est pas là.
///
/// `at` et non `field` : le vocabulaire de vue a désormais une fonction de ce
/// nom. C'est la troisième collision de ce genre, et elle dit une propriété du
/// dessin — voir « Les plugins » dans CLAUDE.md.
///
/// La garde de type n'est pas de la prudence : une API rend un objet là où on
/// en attendait un, et un tableau le lendemain. Demander un champ nommé à un
/// tableau est une erreur d'exécution qui remonte en « Missing instance
/// function », ce qui ne désigne rien de ce qu'on lit. Un champ absent et un
/// champ nul se lisent pareil, ce qui est ce qu'on veut d'un JSON facultatif.
fn at(object, name, fallback) {
    if !(object is Object) {
        return fallback;
    }
    match object.get(name) {
        Some(value) => if value is Tuple { fallback } else { value },
        None => fallback,
    }
}

/// `str_of` et non `text` : le vocabulaire de vue a déjà une fonction de ce
/// nom, et Rune refuse — clairement — qu'un script en redéfinisse une.
fn str_of(object, name) {
    let value = at(object, name, "");
    if value is String {
        value
    } else if value is Tuple {
        ""
    } else {
        `${value}`
    }
}

fn or_else(value, fallback) {
    if value == "" { fallback } else { value }
}

fn escape(query) {
    query.replace(" ", "%20").replace(":", "%3A")
}

// — Ce que les valeurs veulent dire —————————————————————————————————————

fn glyph(level) {
    if level == "fatal" || level == "error" {
        "circle-x"
    } else if level == "warning" {
        "triangle-alert"
    } else {
        "info"
    }
}

fn tone_of(level) {
    if level == "fatal" || level == "error" {
        "danger"
    } else if level == "warning" {
        "warning"
    } else if level == "info" {
        "info"
    } else {
        ""
    }
}

fn status_tone(status) {
    if status == "resolved" {
        "success"
    } else if status == "ignored" || status == "archived" {
        ""
    } else {
        "warning"
    }
}

fn level_tone(key, value) {
    if key == "handled" {
        if value == "yes" { "success" } else { "danger" }
    } else {
        tone_of(value)
    }
}

/// La grammaire d'un extrait, d'après le nom du fichier.
///
/// Le panneau ne colore que ce qu'on nomme : deviner d'après le texte est ce
/// qui fait peindre une transcription de shell en Rust.
fn language_of(path) {
    let name = path.to_lowercase();
    if name.ends_with(".php") || name.ends_with(".phtml") {
        "php"
    } else if name.ends_with(".rs") {
        "rust"
    } else if name.ends_with(".tsx") || name.ends_with(".jsx") {
        "tsx"
    } else if name.ends_with(".ts") {
        "typescript"
    } else if name.ends_with(".js") || name.ends_with(".mjs") || name.ends_with(".cjs") {
        "javascript"
    } else if name.ends_with(".py") {
        "python"
    } else if name.ends_with(".rb") {
        "ruby"
    } else if name.ends_with(".go") {
        "go"
    } else if name.ends_with(".java") {
        "java"
    } else if name.ends_with(".ex") || name.ends_with(".exs") {
        "elixir"
    } else if name.ends_with(".css") || name.ends_with(".scss") {
        "css"
    } else if name.ends_with(".html") || name.ends_with(".vue") {
        "html"
    } else {
        ""
    }
}

/// Depuis quand, en mots.
///
/// L'hôte ne rend que deux choses — l'heure qu'il est et ce qu'une date vaut —
/// et l'écrire est la part qui parle une langue, donc celle du script.
fn ago(stamp) {
    let when = epoch(stamp);
    if when == 0 {
        return "";
    }
    let since = now() - when;
    if since < 0 {
        since = 0;
    }
    if since < 90 {
        `il y a ${since} s`
    } else if since < 5400 {
        `il y a ${since / 60} min`
    } else if since < 172800 {
        `il y a ${since / 3600} h`
    } else if since < 5184000 {
        `il y a ${since / 86400} j`
    } else if since < 63072000 {
        `il y a ${since / 2592000} mois`
    } else {
        `il y a ${since / 31536000} ans`
    }
}
