// Les exécutions de GitHub Actions du worktree regardé.
//
// Trois points d'entrée, et le partage entre eux est toute la mécanique :
//
//   init(worktree)                -> Result<état>   asynchrone, va chercher
//   view(état)                    -> nœud           synchrone et pur
//   update(état, action, charge)  -> Result<état>   asynchrone, agit
//
// `view` ne touche à rien : c'est ce qui permet de l'appeler chaque fois que
// l'état bouge sans se demander ce qu'elle va déclencher, et c'est la règle de
// toute la fenêtre — ce qui se calcule à l'arrivée d'une donnée ne se calcule
// pas à chaque image.

use claudhub::*;

pub async fn init(worktree) {
    if worktree == "" {
        return Ok(fresh([], "Aucun worktree ouvert."));
    }
    let out = shell(setting("list")).await?;
    let runs = parse(out);
    if runs.is_empty() {
        return Ok(fresh(runs, "Aucune exécution — `gh` est-il installé et authentifié ?"));
    }
    Ok(fresh(runs, ""))
}

// Un seul panneau déclaré, donc `panel` vaut toujours `main` : il est là parce
// que le contrat est le même pour tous les plugins — voir le Sentry livré à
// côté, qui en tient deux.
pub fn view(s, panel) {
    if s.note != "" {
        return empty(s.note);
    }

    let rows = [];
    for run in s.runs {
        rows.push(item(run.title, run.workflow, tally(run), glyph(run)));
    }

    let body = [
        title("Exécutions récentes"),
        list("runs", rows, s.chosen, "choose"),
    ];

    // Le détail n'apparaît qu'une fois une ligne choisie : une section vide
    // pousserait la liste hors de vue pour ne rien dire.
    if s.chosen >= 0 {
        let run = s.runs[s.chosen];
        body.push(section(run.title, [
            dim(`${run.workflow} — ${run.status} ${run.conclusion}`),
            mono(`run ${run.id}`),
            row([
                primary(button("Confier à l'agent", "bot", "hand", run.id)),
                button("Voir le journal", "scroll-text", "log", run.id),
            ]),
        ]));
        if run.log != "" {
            body.push(code(run.log, "text"));
        }
    }
    column(body)
}

pub async fn update(s, action, payload) {
    if action == "choose" {
        s.chosen = payload.parse::<i64>()?;
        // Le journal d'une exécution n'est pas dans la liste : le choisir
        // n'appelle rien, c'est le bouton qui le demande.
        return Ok(s);
    }

    if action == "log" {
        let text = fetch_log(payload).await?;
        s.runs[s.chosen].log = tail(text, 80);
        return Ok(s);
    }

    if action == "hand" {
        // Le journal d'abord, et les champs ensuite : une liaison sur un objet
        // imbriqué garde un emprunt, et le garder **par-dessus un `await`**
        // laisse l'état emprunté au retour — `view` ne peut alors plus le lire,
        // et le panneau se vide sans que rien n'explique pourquoi.
        let text = fetch_log(payload).await?;
        let run_title = s.runs[s.chosen].title;
        let run_workflow = s.runs[s.chosen].workflow;
        // Le collage part dans l'onglet de l'agent : c'est lui qui a le dépôt
        // entre les mains. Claudhub ne parle jamais à une API pour cela — c'est
        // la même décision de cadrage que pour le message de commit proposé.
        agent(`L'exécution CI « ${run_title} » (${run_workflow}) a échoué.
Voici la fin de son journal. Dis-moi ce qui casse, puis corrige-le.

${tail(text, 120)}`);
        // Pas de `notify` : le prompt passe par une relecture, et le script ne
        // sait pas si elle sera confirmée. Voir le plugin Sentry.
        return Ok(s);
    }

    Ok(s)
}

// — Ce qui n'est pas de l'interface ————————————————————————————————————

/// `fresh` et non `state` : le vocabulaire a une fonction de ce nom, et Rune
/// refuse — clairement — qu'un script en redéfinisse une.
fn fresh(runs, note) {
    #{ runs: runs, chosen: -1, note: note }
}

async fn fetch_log(id) {
    shell(setting("log").replace("{id}", id)).await
}

/// Une ligne par exécution, cinq champs séparés par une tabulation — c'est
/// `gh` qui formate, voir le `plugin.toml`.
fn parse(out) {
    let runs = [];
    for line in out.split('\n') {
        let fields = line.split('\t').collect::<Vec>();
        if fields.len() < 5 {
            continue;
        }
        runs.push(#{
            id: fields[0],
            title: fields[1],
            workflow: fields[2],
            status: fields[3],
            conclusion: fields[4],
            log: "",
        });
    }
    runs
}

fn tally(run) {
    if run.conclusion == "" {
        run.status
    } else {
        run.conclusion
    }
}

fn glyph(run) {
    if run.conclusion == "success" {
        "circle-check"
    } else if run.conclusion == "" {
        "loader-circle"
    } else {
        "circle-x"
    }
}

/// La fin d'un journal, qui est la partie où l'échec est écrit.
fn tail(text, lines) {
    let all = text.split('\n').collect::<Vec>();
    if all.len() <= lines {
        return text;
    }
    let kept = [];
    for i in (all.len() - lines)..all.len() {
        kept.push(all[i]);
    }
    join(kept, "\n")
}
